{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Owner: Build & Release. Generated, vendored, coverage, and packaged output
  // is validated by its producing gate and must never masquerade as source.
  "ignore": [
    "coverage/**",
    "dist/**",
    "site/**",
    "apps/desktop/dist/**",
    "apps/desktop/out/**",
    "apps/desktop/release/**",
    "THIRD_PARTY_LICENSES/**"
  ],
  // Owner: Runtime. OpenCode is intentionally launched as a packaged binary;
  // static imports cannot represent that runtime edge.
  "ignoreDependencies": [
    "opencode-ai"
  ],
  "ignoreIssues": {
    // Owner: Cloud Client. Knip does not credit exports consumed only from a
    // configured public entry file. These two exact implementation seams are
    // imported by the published artifacts and transport modules; neither file
    // is itself treated as a public entrypoint.
    "packages/cloud-client/src/domains/artifact-normalizers.ts": [
      "exports"
    ],
    "packages/cloud-client/src/domains/shared.ts": [
      "exports",
      "types"
    ]
  },
  "workspaces": {
    ".": {
      "entry": [
        ".github/scripts/release-signing-mode.mjs",
        ".github/scripts/release-windows-signing-mode.mjs",
        // Owner: Build & Release. Docker build stages and the desktop signing
        // hook invoke these files outside package.json, so Knip cannot infer
        // their execution edges.
        "scripts/compose-config-schema.mjs",
        "scripts/desktop-after-sign.mjs",
        "scripts/prune-cloud-runtime.mjs",
        "scripts/prune-gateway-runtime.mjs",
        "tests/*.test.ts"
      ],
      "project": [
        "scripts/**/*.{js,mjs,ts}",
        ".github/scripts/*.mjs",
        "*.config.{js,mjs,ts}",
        "tests/**/*.{ts,mjs}"
      ],
      // Owner: Build, Release & Test. These are explicit host-tool probes and
      // platform commands; they are not package-manager binaries.
      "ignoreBinaries": [
        "codesign",
        "gcloud",
        "gh",
        "launchctl",
        "mkfifo",
        "open",
        "ps",
        // Owner: Desktop Test. Windows process cleanup uses the operating-system
        // taskkill command from a cross-platform smoke harness.
        "taskkill"
      ],
      // Owner: Cloud Runtime. The pruned production closure installs generated
      // bundle externals from this root manifest; their source imports live in
      // workspace packages, so Knip cannot infer the required root declarations.
      "ignoreDependencies": [
        "@aws-sdk/client-s3",
        "google-auth-library"
      ]
    },
    "apps/desktop": {
      "entry": [
        "src/main/index.ts",
        "src/preload/index.ts",
        "tests/*.smoke.test.ts",
        "tests/*.packaged.test.ts",
        "tests/*.eval.test.ts",
        "tests/screenshots.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "tests/**/*.{ts,tsx}"
      ],
      "ignore": [],
      // Owner: Desktop Test. The packaged macOS harness launches an exact app
      // bundle through LaunchServices and temporarily supplies one restored
      // authorization key; neither command is a package-manager binary.
      "ignoreBinaries": [
        "launchctl",
        "open"
      ],
      // Owner: Desktop Runtime. The shared renderer is composed through Vite's
      // source alias, electron-builder is invoked by the dist script, Google
      // auth stays external in the packaged main process, and OpenCode is
      // loaded/launched through the packaged runtime boundary.
      "ignoreDependencies": [
        "@open-cowork/app",
        "electron-builder",
        "google-auth-library",
        "opencode-ai"
      ]
    },
    "packages/app": {
      "entry": [
        "src/index.tsx",
        "src/loading.ts",
        "src/chart-frame.ts",
        "src/browser/browser-main.tsx"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      // Owner: Design System. Font packages are side-effect CSS entrypoints
      // selected by the browser bundle.
      "ignoreDependencies": [
        "@fontsource-variable/mona-sans",
        "@fontsource-variable/schibsted-grotesk",
        "tailwindcss"
      ]
    },
    "apps/channel-gateway": {
      "entry": [
        "src/index.ts",
        "src/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "apps/standalone-gateway": {
      "entry": [
        "src/index.ts",
        "src/main.ts",
        "src/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/shared": {
      "entry": [
        "src/index.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/runtime-host": {
      "entry": [
        "src/index.ts",
        "src/config.ts",
        "src/runtime-managed-server-supervisor.ts"
      ],
      "project": [
        "src/**/*.ts"
      ],
      // Owner: Runtime. These are operating-system commands and Electron's
      // packaged process API, not JavaScript dependencies.
      "ignoreBinaries": [
        "ps",
        "lsof",
        "taskkill"
      ],
      "ignoreDependencies": [
        "electron"
      ]
    },
    "packages/ui": {
      "entry": [
        "src/index.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "packages/cloud-client": {
      // Owner: Cloud Client. These exact source files map one-for-one to the
      // reviewed public subpaths in package.json; a wildcard would hide new,
      // accidentally exported modules.
      "entry": [
        "src/index.ts",
        "src/adapter.ts",
        "src/domains/admin.ts",
        "src/domains/admin-governance.ts",
        "src/domains/artifacts.ts",
        "src/domains/billing.ts",
        "src/domains/byok.ts",
        "src/domains/capabilities.ts",
        "src/domains/channels.ts",
        "src/domains/config.ts",
        "src/domains/identity.ts",
        "src/domains/launchpad.ts",
        "src/domains/sessions.ts",
        "src/domains/settings.ts",
        "src/domains/threads.ts",
        "src/domains/transport.ts",
        "src/domains/workflows.ts",
        // These declaration sources are re-exported by the exact public
        // subpaths above. Listing them individually preserves those existing
        // APIs without turning the implementation tree into an entry glob.
        "src/contracts.ts",
        "src/domain-clients/channels.ts",
        "src/domain-clients/sessions.ts",
        "src/domain-clients/threads.ts",
        "src/domain-clients/transport.ts",
        "src/errors.ts",
        "test/public-import-smoke.mjs"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.mjs"
      ]
    },
    "packages/cloud-server": {
      "entry": [
        "src/index.ts",
        "src/app.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/gateway-channel": {
      "entry": [
        "src/index.ts",
        "src/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/gateway-provider-cli": {
      "entry": [
        "src/index.ts",
        "src/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/gateway-provider-discord": {
      "entry": [
        "src/index.ts",
        "src/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/gateway-provider-email": {
      "entry": [
        "src/index.ts",
        "src/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/gateway-provider-signal": {
      "entry": [
        "src/index.ts",
        "src/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/gateway-provider-slack": {
      "entry": [
        "src/index.ts",
        "src/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/gateway-provider-telegram": {
      "entry": [
        "src/index.ts",
        "src/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/gateway-provider-webhook": {
      "entry": [
        "src/index.ts",
        "src/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/gateway-provider-whatsapp": {
      "entry": [
        "src/index.ts",
        "src/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/gateway-testing": {
      "entry": [
        "src/index.ts",
        "src/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "products/gateway": {
      "entry": [
        "src/cli.ts",
        "src/daemon.ts",
        "src/mcp.ts",
        "src/__tests__/**/*.test.ts",
        // Owner: Durable Gateway Test. These two helpers are launched as
        // subprocess programs by filename; other helpers must stay reachable
        // through imports so Knip can detect orphaned support code.
        "src/__tests__/helpers/leadership-holder.ts",
        "src/__tests__/helpers/store-contender.ts",
        // Owner: Durable Gateway. Release artifact validation reads and ships
        // these Docker smoke programs by filename; that edge is not an import.
        "scripts/docker-auth-smoke.mjs",
        "scripts/docker-compose-auth-smoke.mjs"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.mjs"
      ],
      "includeEntryExports": false,
      // Owner: Durable Gateway. OpenCode and process inspection are explicit
      // subprocess boundaries exercised by integration tests.
      "ignoreBinaries": [
        "opencode",
        "ps"
      ]
    },
    "products/wiki": {
      "entry": [
        "package.json",
        "tests/*.test.ts",
        // Owner: Wiki Release. The package tarball smoke is invoked after the
        // artifact filename is resolved dynamically.
        "scripts/openwiki-packaged-cli-smoke.mjs"
      ],
      "project": [
        "scripts/*.mjs",
        "tests/**/*.ts"
      ],
      // Owner: Wiki. The static-export verification invokes the host Python
      // interpreter; it is not a JavaScript package dependency.
      "ignoreBinaries": [
        "python3"
      ]
    },
    "products/wiki/packages/*": {
      "entry": [
        "src/index.ts",
        "src/main.ts",
        "test/*.test.ts"
      ],
      "project": [
        "**/*.{ts,mjs}"
      ]
    },
    "mcps/charts": {
      "entry": [
        "src/index.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "mcps/agents": {
      "entry": [
        "src/index.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "mcps/skills": {
      "entry": [
        "src/index.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "mcps/workflows": {
      "entry": [
        "src/index.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "mcps/knowledge": {
      "entry": [
        "src/index.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "mcps/semantic-ui": {
      "entry": [
        "src/index.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "mcps/wiki": {
      "entry": [
        "src/index.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  }
}
