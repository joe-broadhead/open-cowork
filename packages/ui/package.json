{
  "name": "@open-cowork/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Open Cowork React UI primitives",
  "author": "Joe Broadhead",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/joe-broadhead/open-cowork.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./badge": {
      "types": "./dist/Badge.d.ts",
      "import": "./dist/Badge.js"
    },
    "./card": {
      "types": "./dist/Card.d.ts",
      "import": "./dist/Card.js"
    },
    "./primitive-gallery": {
      "types": "./dist/PrimitiveGallery.d.ts",
      "import": "./dist/PrimitiveGallery.js"
    },
    "./studio": {
      "types": "./dist/StudioPrimitives.d.ts",
      "import": "./dist/StudioPrimitives.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "node ../../scripts/workspace-build-freshness.mjs --self && node test/public-import-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
    "@open-cowork/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3"
  }
}
