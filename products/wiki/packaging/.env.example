# OpenWiki hosted reference stack — environment contract (copy to .env and edit).
#
# Required
OPENWIKI_PUBLIC_ORIGIN=https://wiki.example.com
OPENWIKI_DATABASE_PASSWORD=change-me-long-random-string

# Host port for the wiki (default 3030)
OPENWIKI_HTTP_PORT=3030

# --- Identity --------------------------------------------------------------
# Human SSO happens at your reverse proxy (Authentik/Keycloak/Caddy/Cloudflare
# Access): the proxy authenticates and injects signed x-openwiki-* headers.
# Set OPENWIKI_TRUST_AUTH_HEADERS_SECRET to a long random secret; the proxy must
# send it as x-openwiki-proxy-secret and strip all client-supplied x-openwiki-*.
OPENWIKI_TRUST_AUTH_HEADERS_SECRET=
# Agent/API auth: OAuth 2.1 with PKCE + dynamic clients (ADR 0008). Enable to
# expose MCP over HTTP; issuer defaults to OPENWIKI_PUBLIC_ORIGIN.
OPENWIKI_OAUTH_ENABLED=0
OPENWIKI_OAUTH_ISSUER=
OPENWIKI_OAUTH_CSRF_SECRET=
# Bootstrap admin token (optional; create scoped tokens with `auth token create`)
OPENWIKI_ADMIN_TOKEN=

# --- Git source of truth ---------------------------------------------------
# Remote for `cron` sync automation, e.g. git@github.com:org/wiki.git or
# git@git-server:/srv/git/wiki.git (self-hosted: use the `git` compose profile).
# Mount the app SSH key at ./secrets/ssh/id_ed25519 (and config/known_hosts).
OPENWIKI_SYNC_REMOTE=
OPENWIKI_GIT_REMOTE_SCHEMES=https,ssh

# --- Operations ------------------------------------------------------------
OPENWIKI_WORKER_MAX_JOBS=1
OPENWIKI_WORKER_POLL_MS=2000
OPENWIKI_BACKUP_INTERVAL_SECONDS=3600
TZ=UTC

# --- Optional S3/MinIO backups (compose --profile s3) ----------------------
# After `up -d --profile s3`, configure the destination once:
#   docker compose exec wiki openwiki backup configure minio --id backup-s3 \
#     --endpoint-url http://minio:9000 --bucket openwiki --prefix backups \
#     --access-key-env MINIO_ROOT_USER --secret-key-env MINIO_ROOT_PASSWORD \
#     --force-path-style --allow-insecure-http
MINIO_ROOT_USER=openwiki
MINIO_ROOT_PASSWORD=change-me-minio-secret
