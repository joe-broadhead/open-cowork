{
  "name": "@open-cowork/channel-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Headless Open Cowork channel gateway daemon",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/workspace-build-freshness.mjs --self && node --no-warnings --experimental-strip-types --test src/*.test.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@open-cowork/cloud-client": "workspace:*",
    "@open-cowork/gateway-channel": "workspace:*",
    "@open-cowork/gateway-provider-email": "workspace:*",
    "@open-cowork/gateway-provider-cli": "workspace:*",
    "@open-cowork/gateway-provider-discord": "workspace:*",
    "@open-cowork/gateway-provider-signal": "workspace:*",
    "@open-cowork/gateway-provider-slack": "workspace:*",
    "@open-cowork/gateway-provider-telegram": "workspace:*",
    "@open-cowork/gateway-provider-webhook": "workspace:*",
    "@open-cowork/gateway-provider-whatsapp": "workspace:*",
    "@open-cowork/gateway-testing": "workspace:*",
    "@open-cowork/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^6.0.0"
  }
}
