{
  "name": "@open-cowork/standalone-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone Open Cowork Gateway execution appliance with private OpenCode and Postgres",
  "main": "dist/index.js",
  "bin": {
    "open-cowork-gateway-standalone": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/workspace-build-freshness.mjs --self && node --no-warnings --experimental-strip-types --test src/*.test.ts",
    "start": "node dist/main.js serve",
    "doctor": "node dist/main.js doctor",
    "identity": "node dist/main.js identity",
    "smoke": "node dist/main.js smoke"
  },
  "dependencies": {
    "@open-cowork/gateway-channel": "workspace:*",
    "@open-cowork/gateway-provider-telegram": "workspace:*",
    "@open-cowork/gateway-provider-webhook": "workspace:*",
    "@open-cowork/gateway-testing": "workspace:*",
    "@open-cowork/shared": "workspace:*",
    "@opencode-ai/sdk": "1.18.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^6.0.0"
  }
}
